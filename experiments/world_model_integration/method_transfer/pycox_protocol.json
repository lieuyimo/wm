  "training_features": "frozen at observed service start",
  "time_origin": "service_started tick",
  "end_time": "service_finished tick - service_started tick; right censor at episode terminal tick",
  "time_bins": "integer grid [0..max_training_duration+2] chosen from training ONLY; >grid fallback public rule",
