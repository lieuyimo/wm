  "mechanisms": {
    "independent": {
      "family": "discrete_binomial_bernoulli",
      "base_probability": 0.22,
      "shift_probability": 0.34,
      "mark_probability_w0": 0.5
    },
    "periodic": {
      "family": "jittered_interval",
      "intervals": [
        4,
        5,
        6
      ],
      "shift_intervals": [
        3,
        7,
        9
      ],
      "first_tick_max": 4,
      "mark_probability_w0": 0.5
    },
    "bursty": {
      "family": "hidden_two_state_markov",
      "base_probs": [
        0.08,
        0.42
      ],
      "shift_probs": [
        0.03,
        0.6
      ],
      "block_length": 8,
      "base_switch_probability": 0.28,
      "shift_switch_probability": 0.16,
      "mark_probs_w0_by_latent_state": [
        0.75,
        0.25
      ]
    }
  },
  "tick_window": 75,
  "max_business_ticks": 240,
  "deadline_tick": 220,
  "workflow_types": [
    "w0",
    "w1"
  ],
  "public_marker": "first stage_index==0 job_id visible for first time in BusinessObserver observation",
  "exposure": "only actually observed ticks; if simulator ends early, not-yet-observed future ticks censored and excluded",
  "episode_inputs": "past and current visible first-job arrivals, current public clock, known public station/task/robot state; never generator mechanism label or future releases",
  "easytpp": {
    "schema": "jsonl per event-sequence with time_since_start,time_since_last_event,type_event,dim_process=2",
    "model_ids": [
      "NHP",
      "IntensityFree"
    ],
    "version": "0.2.4",
    "training": "development train and validation only; shift_test and test never used for selection"
  },
  "baselines": {
    "global_poisson": "train exposure weighted constant per-tick arrival intensity",
    "history_smoothed": "(observed events over preceding window + prior global rate*4)/(observed ticks + 4)",
    "history_windows": [
      4,
      8,
      16
    ],
    "selection": "minimum validation H20 Poisson predictive NLL, tie -> simpler",
    "evaluation": {
      "horizons": [
        5,
        20
      ],
      "anchor_ticks": [
        8,
        16,
        24,
        32,
        40
      ],
      "metrics": [
        "count_mae",
        "count_poisson_nll",
        "mark_cross_entropy"
      ]
    }
  },
  "resources": {
    "gpu_available_in_connected_ci": false,
    "cpu_proxy_for_data": true,
    "allow_training_when_model_worthwhile": true,
    "assert_no_holdout_training": true,
    "runner_timeout_minutes": 35
  },
  "inference_targets": "H5/H20 future count and marked events first, next stage external public arrival event transition only after proven independent prediction",
  "no_overwrite": true
