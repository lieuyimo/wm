  "independent_group_unit": "scenario_seed",
  "max_ticks": 240,
  "scene_parameters_are_simulated_not_real_lab_measurements": true,
  "first_action_pair": {
    "candidate_source": "Existing BusinessCPSAT.proposals at t=0 (up to first two DISTINCT legal plans)",
    "selection": "first or second legal proposal; rest of each true run uses native BusinessCPSAT first proposal",
    "solver": {
      "limit": 4,
      "wall_seconds": 0.08,
      "deterministic_seconds": 0.04,
      "seed": 1810
    },
    "common_randomness": "Existing keyed service duration by scene_seed/task/phase/station; no stochastic data mechanism changed",
    "oracle_scope": "only the first two proposals, same continuation algorithm, no counterfactual truth used by predictor",
    "on_censoring": "report censored scenes, never treat 240 tick timeout as true completion time"
  },
  "prediction": {
    "horizons": [
      5,
      10,
      20
    ],
    "particles": 3,
    "anchor_tick": 0,
    "continuation": "Existing BusinessCPSAT first proposal computed on each particle's public predicted state",
    "sampling_seed_formula": "1810+observed_tick*101+sample_count*271 (same between candidate policies, independent of horizons)",
    "ranking": "Higher forecast expected_completed_samples at h; on tie choose CP-SAT first candidate; do not tune weight",
    "time_budget_seconds_per_pair": 0.5,
    "coverage": "At h, state error measured only if factual public observation exists at exact h; no invented terminal state padding",
    "scoring": [
      "full-state sample_status_error",
      "robot_task_error",
      "robot_phase_error",
      "robot_position_l1",
      "station_busy_brier",
      "resource_occupancy_mae",
      "waiting_count_mae",
      "completed_count_mae",
      "in_transit_count_mae"
    ],
    "decision_metrics": [
      "candidate_set_makespan_regret_ticks",
      "candidate_set_late_job_regret",
      "pairwise_sign_accuracy_non_tie",
      "candidate_flip_count",
      "prediction_cpu_time_per_pair",
      "coverage_and_censoring"
    ]
  },
  "comparison": "Compare Rule and frozen V4 at SAME horizon and same scene; H20 vs H5 differences in ACTION DISTINCTION rather than claiming more accurate prediction from a longer horizon",
  "frozen_go_gate": "Only if independent high-load/shift groups show nonzero true action utility differences, candidate-ranked V4 has better/equal regret than CP-SAT with reasonable CPU cost; otherwise no model promotion",
  "resource_budget": {
    "gpu": 0,
    "new_training": 0,
    "max_total_cpu_seconds": 480
  },
  "prohibited": [
    "change scene seeds or jitter/queue after seeing test results",
    "tune model weights, loss or score using heldout",
    "use future releases that have not been observed by forecast",
    "treat forecasting particles as independent scenes",
    "mislabel offline initial-action choice as fully online re-planning policy"
  ]
}
